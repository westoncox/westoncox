---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Drop portfolio images into src/assets/work/; files sort by name, so prefix
// them (01-, 02-, …) to set the order. The alt text comes from the file name.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.{jpg,jpeg,png,webp,avif}", {
  eager: true,
});

const images = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "");
    const alt = name
      .replace(/^\d+[-_ ]*/, "")
      .replace(/[-_]+/g, " ")
      .trim();
    return { src: mod.default, alt };
  });
---

{images.length === 0 ? (
  <p class="empty">Portfolio images are on their way.</p>
) : (
  <ul class="grid">
    {images.map((img, i) => (
      <li>
        <button type="button" class="thumb" data-index={i} aria-label={`View ${img.alt}`}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[400, 800]}
            sizes="(min-width: 60rem) 30vw, (min-width: 36rem) 45vw, 100vw"
            loading={i < 6 ? "eager" : "lazy"}
          />
        </button>
      </li>
    ))}
  </ul>
)}

{images.length > 0 && (
  <dialog class="lightbox" aria-label="Portfolio viewer">
    <button type="button" class="close" aria-label="Close">
      ×
    </button>
    <button type="button" class="nav prev" aria-label="Previous">
      ‹
    </button>
    <div class="frames">
      {images.map((img, i) => (
        <figure data-index={i} hidden>
          <Image src={img.src} alt={img.alt} widths={[1200, 2000]} sizes="90vw" loading="lazy" />
          <figcaption>{img.alt}</figcaption>
        </figure>
      ))}
    </div>
    <button type="button" class="nav next" aria-label="Next">
      ›
    </button>
  </dialog>
)}

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  if (dialog) {
    const frames = [...dialog.querySelectorAll<HTMLElement>("figure")];
    let current = 0;
    const show = (i: number) => {
      current = (i + frames.length) % frames.length;
      frames.forEach((f, n) => (f.hidden = n !== current));
    };
    document.querySelectorAll<HTMLButtonElement>(".thumb").forEach((btn) =>
      btn.addEventListener("click", () => {
        show(Number(btn.dataset.index));
        dialog.showModal();
      }),
    );
    dialog.querySelector(".prev")!.addEventListener("click", () => show(current - 1));
    dialog.querySelector(".next")!.addEventListener("click", () => show(current + 1));
    dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  }
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .thumb {
    all: unset;
    cursor: zoom-in;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--line);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .thumb:hover :global(img),
  .thumb:focus-visible :global(img) {
    transform: scale(1.03);
  }

  .thumb:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .empty {
    color: var(--muted);
  }

  .lightbox {
    border: 0;
    padding: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    background: rgb(10 10 10 / 0.96);
    color: #eee;
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: 3rem 1fr 3rem;
    align-items: center;
  }

  .frames {
    display: grid;
    place-items: center;
    height: 100dvh;
    padding: 3rem 0;
  }

  figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    justify-items: center;
  }

  figure :global(img) {
    max-height: calc(100dvh - 8rem);
    width: auto;
    object-fit: contain;
  }

  figcaption {
    font-size: 0.85rem;
    color: #aaa;
  }

  .lightbox button {
    background: none;
    border: 0;
    color: inherit;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
  }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
  }
</style>
